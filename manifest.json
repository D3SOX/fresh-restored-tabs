{
  "manifest_version": 3,
  "name": "Fresh Restored Tabs",
  "version": "1.0.0",
  "description": "Reloads unloaded Firefox tabs when you open them so they show current content instead of a stale cached copy.",
  "homepage_url": "https://github.com/D3SOX/fresh-restored-tabs",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fresh-restored-tabs@d3sox.me",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
